{
  "name": "extshield",
  "version": "1.0.1",
  "description": "Minify and harden Chrome extensions without breaking Web Store policy — esbuild minification, terser property mangling, WASM sinking and a pre-upload compliance scan.",
  "bin": {
    "extshield": "bin/extshield.js"
  },
  "main": "src/harden.js",
  "scripts": {
    "harden": "node bin/extshield.js harden",
    "verify": "node bin/extshield.js verify",
    "demo": "node bin/extshield.js demo",
    "demo:wasm": "node bin/extshield.js demo --wasm",
    "gui": "node gui/server.js",
    "notices": "node scripts/gen-notices.js",
    "test": "node test/e2e-wasm.js",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "chrome-extension",
    "chrome-web-store",
    "browser-extension",
    "extension",
    "manifest-v3",
    "mv3",
    "minify",
    "minifier",
    "obfuscation",
    "obfuscation-policy",
    "web-store-compliance",
    "code-protection",
    "packager",
    "esbuild",
    "terser",
    "wasm",
    "webassembly",
    "assemblyscript"
  ],
  "author": "TikyZ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TikyZ/extshield.git"
  },
  "bugs": {
    "url": "https://github.com/TikyZ/extshield/issues"
  },
  "homepage": "https://github.com/TikyZ/extshield#readme",
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "templates/",
    "wasm-template/",
    "sample/",
    "gui/",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "THIRD-PARTY-NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "terser": "^5.31.0",
    "acorn": "^8.17.0",
    "assemblyscript": "^0.28.19"
  },
  "devDependencies": {},
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
