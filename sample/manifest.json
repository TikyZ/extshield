{
  "manifest_version": 3,
  "name": "Demo Shield Extension",
  "version": "1.0.0",
  "description": "extshield 的示例扩展,用于演示 harden + verify。",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Demo Shield"
  }
}
